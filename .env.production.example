; Copy to .env for a fresh production installation. Fill ALL database values.
APP_NAME="Lifestyle Store"
APP_ENV=production
APP_URL="https://your-domain.example"
APP_REQUIRE_HTTPS=true
TRUST_PROXY_HEADERS=false
demo=false
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE="cpaneluser_storefront"
DB_USERNAME="cpaneluser_storeuser"
DB_PASSWORD="CHANGE_ME_BEFORE_INSTALL"
; Recommended: private directory outside public_html, writable by this account.
; APP_STORAGE="/home/CPANEL_USERNAME/storefront-storage"
