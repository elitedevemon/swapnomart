; Local Laragon/testing template. Copy to .env and use a NEW database.
APP_NAME="Lifestyle Store"
APP_ENV=local
APP_URL="http://storefront.test"
APP_REQUIRE_HTTPS=false
TRUST_PROXY_HEADERS=false
demo=true
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=storefront_demo
DB_USERNAME=root
DB_PASSWORD=""
; Optional absolute private storage path; default is project/storage.
; APP_STORAGE="C:/private/storefront-storage"
